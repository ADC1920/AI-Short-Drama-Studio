__pycache__/
*.pyc
.DS_Store

# 本地工作承载（会话留档，不随公开仓库发布）
memory/

# 本地生成产物（看板、临时输出）
out/
.studio/

# 工具运行时残留（video2code 插件写入，含本机绝对路径）
.v2c/

# 一次性中间产物
.tmp/

# 机检门日志（运行时数据，供 --stats 汇总，不入库）
.gate-log.jsonl

# 新增能力的运行时产物——派生/可重建，属项目本地数据不入库
# （这些是「用户项目」里的文件；本项目仓库本身不含它们，条目供技能被安装后使用）
_impact.json
_tasks.jsonl
_novel/
_eval/
_refs/

# 说明：_reviews/ 是审查记录（交付物的一部分），默认入库；
# 若项目涉商业内容需保密，由使用方在自己的 .gitignore 追加排除。
